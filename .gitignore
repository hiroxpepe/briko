# Unity meta files for non-tracked folders
*.meta.bak

# Unity's auto-generated assembly artifacts
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.tmp

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vs/
.vscode/
.idea/
bin/
obj/
vs.code-workspace

# Logs
*.log

# Generated code dump
project_all_code.md

# Local NuGet feed config (environment-specific)
Tests~/ConventionTests/nuget.config
Tests~/ConventionTests/TestResults/

# Markdown files are documentation, never a Unity-referenced asset;
# no .meta for them is ever needed.
*.md.meta
